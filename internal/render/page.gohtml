<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{.Policy}}">
<title>{{.Title}}</title>
<link rel="stylesheet" href="/assets/surface.css">
{{if .Stylesheet}}<style>{{.Stylesheet}}</style>{{end}}
</head>
<body data-base="{{.Base}}" data-token="{{.Token}}" data-revision="{{.Revision}}" data-over="{{if .Over}}yes{{else}}no{{end}}">
<main class="surface">
<header class="heading">
<h1>{{.Title}}</h1>
{{if .Preamble}}<p class="preamble">{{.Preamble}}</p>{{end}}
</header>

{{if .Source}}
<nav class="glance" aria-label="What was seen">
<ol class="entries">
{{range .Source}}
<li class="entry">
{{if .Decided}}<a class="entry-name" href="#decision-{{.ID}}">{{.Name}}</a>{{else}}<span class="entry-name">{{.Name}}</span>{{end}}
{{if .Severity}}<span class="severity" data-severity="{{.Severity}}">{{.Severity}}</span>{{end}}
{{if .Audience}}<span class="audience">{{.Audience}}</span>{{end}}
{{if .Location}}<span class="location">{{.Location}}</span>{{end}}
</li>
{{end}}
</ol>
</nav>
{{end}}

{{if .Decisions}}
<ol class="decisions">
{{range .Decisions}}
<li class="decision" id="decision-{{.ID}}" data-decision="{{.ID}}" data-mode="{{.Mode}}" data-state="{{if $.Over}}closed{{else}}open{{end}}">
<div class="attribution">
<span class="name">{{.Name}}</span>
{{if .Severity}}<span class="severity" data-severity="{{.Severity}}">{{.Severity}}</span>{{end}}
{{if .Audience}}<span class="audience">{{.Audience}}</span>{{end}}
{{if .Location}}<span class="location">{{.Location}}</span>{{end}}
</div>
<h2 class="question">{{.Question}}</h2>
{{if .Meaning}}<p class="meaning">{{.Meaning}}</p>{{end}}

{{if .Code}}
<div class="evidence code">
<pre><code class="language-{{.Language}}">{{.Code}}</code></pre>
</div>
{{end}}

{{if .Diff}}
<div class="evidence diff" data-layout="split">
<div class="diff-heading">{{if eq .Diff.From .Diff.To}}<span class="diff-file">{{.Diff.From}}</span>{{else}}<span class="diff-from">{{.Diff.From}}</span><span class="diff-to">{{.Diff.To}}</span>{{end}}</div>
{{range .Diff.Hunks}}
<table class="hunk">
{{if .Heading}}<caption>{{.Heading}}</caption>{{end}}
<tbody>
{{range .Rows}}
<tr class="row">
<td class="number" data-side="left">{{.Left.Numbered}}</td>
<td class="line" data-side="left" data-kind="{{.Left.Kind}}"><span class="marker">{{.Left.Marker}}</span><code>{{.Left.Text}}</code></td>
<td class="number" data-side="right">{{.Right.Numbered}}</td>
<td class="line" data-side="right" data-kind="{{.Right.Kind}}"><span class="marker">{{.Right.Marker}}</span><code>{{.Right.Text}}</code></td>
</tr>
{{end}}
</tbody>
</table>
{{end}}
</div>
{{end}}

{{if .Fragment}}
<div class="evidence illustration"><div class="painted">{{.Fragment}}</div></div>
{{end}}

{{if .Options}}
<fieldset class="options">
<legend>{{if .Multiple}}Choose as many as apply{{else}}Choose one{{end}}</legend>
{{$decision := .}}
{{range .Options}}
<label class="option"{{if .Recommended}} data-recommended="yes"{{end}}>
<input class="choice" data-part="answering" type="{{if $decision.Multiple}}checkbox{{else}}radio{{end}}" name="choice-{{$decision.ID}}" value="{{.Position}}" data-decision="{{$decision.ID}}"{{if $.Over}} disabled{{end}}>
<span class="option-heading">
<span class="option-label">{{.Label}}</span>
{{if .Recommended}}<span class="option-mark">Recommended</span>{{end}}
</span>
{{if .Meaning}}<span class="option-meaning">{{.Meaning}}</span>{{end}}
</label>
{{end}}
</fieldset>
{{end}}

<label class="words">
<span class="words-label">In your own words</span>
<textarea class="words-field" data-part="answering" name="words-{{.ID}}" data-decision="{{.ID}}" rows="3" placeholder="Answering here alone is a complete answer."{{if $.Over}} disabled{{end}}></textarea>
</label>

<div class="commitment">
<button class="commit" data-part="answering" type="button" data-decision="{{.ID}}"{{if $.Over}} disabled{{end}}>Commit this answer</button>
<button class="reopen" data-part="answering" type="button" data-decision="{{.ID}}" hidden{{if $.Over}} disabled{{end}}>Take this answer back</button>
<p class="committed" hidden><span class="committed-said"></span></p>
</div>
</li>
{{end}}
</ol>

<section class="composer">
<label class="message">
<span class="message-label">Anything to say to whoever asked</span>
<textarea class="message-field" data-part="sending" name="message" rows="3"{{if .Over}} disabled{{end}}></textarea>
</label>
<div class="sends">
<button class="send" data-part="sending" type="button" data-ends="no"{{if .Over}} disabled{{end}}>Send and wait for a reply</button>
<button class="finish" data-part="sending" type="button" data-ends="yes"{{if .Over}} disabled{{end}}>Send and finish</button>
</div>
<p class="sends-meaning">Sending waits for a reply on this page. Finishing sends and closes the exchange.</p>
<div class="discarding" hidden>
<p class="discarding-said" role="status" aria-live="polite"></p>
<div class="discarding-choices">
<button class="discard" data-part="sending" type="button"{{if .Over}} disabled{{end}}>Finish anyway</button>
<button class="keep" data-part="sending" type="button"{{if .Over}} disabled{{end}}>Keep answering</button>
</div>
</div>
<p class="state" role="status" aria-live="polite">{{if .Over}}The exchange is over. Nothing further will be sent from this page.{{end}}</p>
</section>
{{else}}
<section class="nothing">
<p class="nothing-said">There is nothing on this page to answer, and nobody is waiting on it.</p>
</section>
{{end}}
</main>
<script src="/assets/surface.js"></script>
</body>
</html>
