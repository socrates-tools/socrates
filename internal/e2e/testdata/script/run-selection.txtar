# Naming no run means the current repository's most recent, and never another repository's.

[!exec:git] skip
[!exec:sh] skip

cd here
exec git -c init.defaultBranch=main init --quiet .
exec git add -A
exec git commit --quiet -m 'the first commit'
cp $WORK/added.go added.go
exec socrates review begin --wait
stdout 'state: clean'
cp stdout $WORK/here.txt

cd $WORK/there
exec git -c init.defaultBranch=main init --quiet .
exec git add -A
exec git commit --quiet -m 'the first commit'
cp $WORK/added.go added.go
exec socrates review begin --wait
stdout 'state: clean'
cp stdout $WORK/there.txt

# The bare command reports on the repository it is run in, and not on the other one.
exec sh -c 'socrates review status > status.txt'
grep 'state: clean' status.txt
exec sh -c 'grep -q "run: $(head -1 $WORK/there.txt)" status.txt'
exec sh -c 'if grep -q "$(head -1 $WORK/here.txt)" status.txt; then exit 1; fi'

cd $WORK/never
exec git -c init.defaultBranch=main init --quiet .
exec git add -A
exec git commit --quiet -m 'the first commit'

# A repository that has never been reviewed says so and exits with the usage code.
exec sh -c 'socrates review status; echo exit=$?'
stdout 'exit=3'
stderr 'never been reviewed'

# Outside a repository there is nothing to report on either.
cd $WORK/elsewhere
exec sh -c 'socrates review status; echo exit=$?'
stdout 'exit=3'
stderr 'not inside a git working tree'

-- here/README.md --
socrates review
-- there/README.md --
socrates review
-- never/README.md --
socrates review
-- elsewhere/notes.txt --
nothing here is a repository
-- added.go --
package repo
-- clean.yaml --
default:
  structured: '{"findings":[],"risk_level":"low","risk_rationale":"a small and self-contained change"}'
