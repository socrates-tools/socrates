# Following a run, reading it afterwards, piping either, and asking about a run that does not exist.

[!exec:git] skip
[!exec:sh] skip

cd repo
exec git -c init.defaultBranch=main init --quiet .
exec git add -A
exec git commit --quiet -m 'the first commit'

# Following a review to its verdict exits with the verdict's code and renders what happened.
cp $WORK/added.go added.go
exec sh -c 'socrates-review review > /dev/null; socrates-review watch; echo exit=$?'
stdout 'exit=0'
stdout 'the run started on'
stdout 'the reviewer answered'
stdout 'state: clean'

# Reading the finished run says the same thing, without following anything.
exec sh -c 'socrates-review logs; echo exit=$?'
stdout 'exit=0'
stdout 'the run started on'
stdout 'state: clean'

# Neither command starts a pager where its output is not a terminal.
env PAGER=$WORK/loud-pager
exec sh -c 'socrates-review logs | cat; echo exit=$?'
stdout 'exit=0'
stdout 'state: clean'
! stdout 'PAGED'

# A run identifier no run has is refused at once, naming it, rather than waited for.
exec sh -c 'socrates-review watch 20200101T000000Z-deadbeef; echo exit=$?'
stdout 'exit=3'
stderr '20200101T000000Z-deadbeef'
exec sh -c 'socrates-review logs 20200101T000000Z-deadbeef; echo exit=$?'
stdout 'exit=3'
stderr '20200101T000000Z-deadbeef'

# A review that found something blocking is followed to its own code.
env SOCRATES_SIM_SCENARIO=$WORK/escalating.yaml
exec sleep 1
cp $WORK/other.go other.go
exec sh -c 'socrates-review review > /dev/null; socrates-review watch; echo exit=$?'
stdout 'exit=1'
stdout 'state: escalated'
stdout 'asking for nothing'

-- repo/README.md --
socrates-review
-- added.go --
package repo
-- other.go --
package repo
-- clean.yaml --
default:
  structured: '{"findings":[],"risk_level":"low","risk_rationale":"a small and self-contained change"}'
-- escalating.yaml --
default:
  structured: '{"findings":[{"id":"f1","severity":"error","file":"other.go","line":1,"description":"The change takes away a behaviour the importer depends on, and nothing here can put it back.","action":"no-op"}],"risk_level":"high","risk_rationale":"what holds the change is not something a patch closes"}'
-- loud-pager --
#!/bin/sh
sed 's/^/PAGED /'
