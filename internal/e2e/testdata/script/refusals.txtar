# Every refusal names the condition and exits with the usage code rather than a verdict.

[!exec:git] skip
[!exec:sh] skip

# Outside a repository there is nothing to review.
cd elsewhere
exec sh -c 'scrat review; echo exit=$?'
stdout 'exit=3'
stderr 'not inside a git working tree'
stderr 'run scrat review from inside a repository'

# A repository with no commit has no base to review against.
cd $WORK/fresh
exec git -c init.defaultBranch=main init --quiet .
exec sh -c 'scrat review; echo exit=$?'
stdout 'exit=3'
stderr 'no commit for HEAD'
stderr 'commit something first'

# A run that does not exist is a usage error and not a verdict.
cd $WORK/repo
exec git -c init.defaultBranch=main init --quiet .
exec git add -A
exec git commit --quiet -m 'the first commit'
exec sh -c 'scrat status 20200101T000000Z-deadbeef; echo exit=$?'
stdout 'exit=3'
stderr 'there is no run named 20200101T000000Z-deadbeef'

# The stated intent is the only free text a caller may supply.
exec sh -c 'scrat review "I refactored the parser and it all works"; echo exit=$?'
stdout 'exit=3'
stderr 'I refactored the parser and it all works'
stderr '--intent'

# A review inside a review spawns without end, so it is refused.
env SOCRATES_RUN=20260819T041530Z-ee66fe34
exec sh -c 'scrat review; echo exit=$?'
stdout 'exit=3'
stderr '20260819T041530Z-ee66fe34'
env SOCRATES_RUN=

# A configuration file that does not parse is a refusal rather than a silent default.
mkdir $WORK/config/socrates
cp $WORK/broken.yaml $WORK/config/socrates/config.yaml
exec sh -c 'scrat review; echo exit=$?'
stdout 'exit=3'
stderr 'config.yaml'

-- elsewhere/notes.txt --
nothing here is a repository
-- fresh/README.md --
socrates
-- repo/README.md --
socrates
-- broken.yaml --
roles: [this is not a mapping
-- clean.yaml --
default:
  structured: '{"findings":[],"risk_level":"low","risk_rationale":"a small and self-contained change"}'
