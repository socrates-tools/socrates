root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{md,yaml,yml,json,js,mjs,ts,css,html,gohtml,sh}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[internal/e2e/testdata/**]
trim_trailing_whitespace = false
insert_final_newline = false
