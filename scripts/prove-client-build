#!/bin/sh
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

failures=0

fresh() {
  rm -rf "$scratch/agora" "$scratch/site"
  mkdir -p "$scratch/agora/assets" "$scratch/agora/document" "$scratch/site"
  cp -a "$root/agora/web" "$scratch/agora/web"
  cp -a "$root/agora/render" "$scratch/agora/render"
  cp "$root/site/index.html" "$root/site/site.css" "$scratch/site/"
}

build() {
  (cd "$scratch/agora/web" && node build.mjs 2>&1)
}

fail() {
  echo "FAIL: $1" >&2
  failures=$((failures + 1))
}

fresh
if ! output=$(build); then
  fail "an untouched client did not build: $output"
elif ! grep -q 'Ivan Sagalaev' "$scratch/agora/assets/bundle/surface.js"; then
  fail "the highlight.js notice did not reach the bundle"
elif ! grep -q 'Copyright (c) 2017 Google LLC' "$scratch/agora/assets/bundle/surface.js"; then
  fail "the Lit notice did not reach surface.js"
elif ! grep -q 'Copyright (c) Tailwind Labs, Inc.' "$scratch/agora/assets/bundle/surface.css"; then
  fail "the Tailwind notice did not reach surface.css"
elif ! grep -q 'Copyright (c) Tailwind Labs, Inc.' "$scratch/site/site.generated.css"; then
  fail "the Tailwind notice did not reach the landing page's stylesheet"
elif ! grep -qF '.bg-accent{' "$scratch/site/site.generated.css"; then
  fail "the landing page's stylesheet holds no rule for a utility the page uses"
fi

fresh
printf '<p class="bg-state-error-wash"></p>\n' >> "$scratch/site/index.html"
if ! output=$(build); then
  fail "a landing page naming a utility did not build: $output"
elif ! grep -qF '.bg-state-error-wash{' "$scratch/site/site.generated.css"; then
  fail "the landing page's stylesheet holds no rule for a utility added to the page"
fi

fresh
printf "export const classes = 'bg-red-500 rounded-lg bg-accent rounded-pill font-body p-4'\n" > "$scratch/agora/web/packages/surface/probe.ts"
if ! output=$(build); then
  fail "a template naming utilities did not build: $output"
else
  css="$scratch/agora/assets/bundle/surface.css"
  for rule in '.bg-accent{' '.rounded-pill{' '.font-body{' '.p-4{padding:calc(var(--spacing) * 4)}'; do
    if ! grep -qF "$rule" "$css"; then
      fail "the stylesheet holds no rule $rule for a utility that is a token"
    fi
  done
  for rule in '.bg-red-500' '.rounded-lg'; do
    if grep -qF "$rule" "$css"; then
      fail "the stylesheet holds a rule $rule for a utility that is not a token"
    fi
  done
fi

fresh
printf "export const reached = document.body.shadowRoot\n" >> "$scratch/agora/web/packages/surface/exchange.ts"
if output=$(build); then
  fail "a surface file naming shadowRoot did not stop the build"
elif ! printf '%s' "$output" | grep -Eq 'packages/surface/exchange\.ts:[0-9]+'; then
  fail "a surface file naming shadowRoot was refused without naming its file and line: $output"
elif [ -e "$scratch/agora/assets/bundle/surface.js" ]; then
  fail "a surface file naming shadowRoot still wrote a bundle"
fi

fresh
printf "export const inside = (element: Element) => element.shadowRoot\n" > "$scratch/agora/web/packages/ui/inside.ts"
if ! output=$(build); then
  fail "a library file naming shadowRoot was refused, and a primitive's own file may: $output"
fi

fresh
printf "export const quoted = 'http://example.com/*not a comment*/'\nexport const templated = \`//\${quoted}\`\n" >> "$scratch/agora/web/packages/surface/exchange.ts"
if ! output=$(build); then
  fail "a string holding comment markers was refused as a comment: $output"
fi

fresh
printf "export const wrong: number = 'not a number'\n" >> "$scratch/agora/web/packages/surface/exchange.ts"
if output=$(build); then
  fail "a type error did not stop the build"
elif ! printf '%s' "$output" | grep -Eq 'packages/surface/exchange\.ts:[0-9]+'; then
  fail "a type error was refused without naming its file and line: $output"
elif [ -e "$scratch/agora/assets/bundle/surface.js" ]; then
  fail "a type error still wrote a bundle"
fi

for comment in '// a line comment' '/* a block comment */' '/** a documentation comment */'; do
  fresh
  printf 'export const commented = 1 %s\n' "$comment" >> "$scratch/agora/web/packages/surface/exchange.ts"
  if output=$(build); then
    fail "a comment ($comment) did not stop the build"
  elif ! printf '%s' "$output" | grep -Eq 'packages/surface/exchange\.ts:[0-9]+'; then
    fail "a comment ($comment) was refused without naming its file and line: $output"
  elif [ -e "$scratch/agora/assets/bundle/surface.js" ]; then
    fail "a comment ($comment) still wrote a bundle"
  fi
done

library_imports() {
  label=$1
  file=$2
  content=$3
  fresh
  printf '%s\n' "$content" > "$scratch/agora/web/packages/ui/$file"
  if output=$(build); then
    fail "$label did not stop the build"
  elif ! printf '%s' "$output" | grep -Eq "packages/ui/$file"; then
    fail "$label was refused without naming its file: $output"
  elif [ -e "$scratch/agora/assets/bundle/surface.js" ]; then
    fail "$label still wrote a bundle"
  fi
}

library_imports "a library module importing the surface by path" "reaching.ts" "import { exchangeIsOver } from '../surface/exchange'
export const reached = exchangeIsOver"
library_imports "a library module importing the surface by name" "naming.ts" "import { exchangeIsOver } from '@agora/surface/exchange'
export const named = exchangeIsOver"
library_imports "a library stylesheet importing the surface" "tokens/reaching.css" "@import '../../surface/surface.css';"

until_it() {
  for _ in $(seq 1 100); do
    if eval "$1"; then
      return 0
    fi
    sleep 0.3
  done
  return 1
}

fresh
watching="$scratch/watching.log"
(cd "$scratch/agora/web" && exec node build.mjs --watch >"$watching" 2>&1) &
watcher=$!
if ! until_it "[ -e '$scratch/agora/assets/bundle/surface.js' ]"; then
  fail "the watch did not build the bundle"
fi
printf "export const wrong: number = 'not a number'\n" >> "$scratch/agora/web/packages/surface/exchange.ts"
if ! until_it "grep -Eq 'packages/surface/exchange\\.ts:[0-9]+' '$watching'"; then
  fail "the watch did not print a saved type error"
elif ! kill -0 "$watcher" 2>/dev/null; then
  fail "the watch stopped on a saved type error"
fi
printf "console.log('rebuilt after the fix')\n" >> "$scratch/agora/web/packages/surface/height.ts"
sed -i '/export const wrong/d' "$scratch/agora/web/packages/surface/exchange.ts"
if ! until_it "grep -qs 'rebuilt after the fix' '$scratch/agora/assets/bundle/height.js'"; then
  fail "the watch did not rebuild the bundle once the type error was fixed: $(cat "$watching")"
fi
kill "$watcher" 2>/dev/null || true
wait "$watcher" 2>/dev/null || true

if [ "$failures" -ne 0 ]; then
  exit 1
fi
