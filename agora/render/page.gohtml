<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta http-equiv="Content-Security-Policy" content="{{.Policy}}">
<title>{{.Title}}</title>
<link rel="icon" type="image/svg+xml" href="/assets/socrates-mark.svg">
<link rel="stylesheet" href="/assets/surface.css">
</head>
<body data-base="{{.Base}}" data-token="{{.Token}}" data-revision="{{.Revision}}" data-over="{{if .Over}}yes{{else}}no{{end}}">
{{define "check"}}<svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"/></svg>{{end}}
{{define "expand"}}<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" x2="14" y1="3" y2="10"/><line x1="3" x2="10" y1="21" y2="14"/></svg>{{end}}
{{define "copy"}}<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>{{end}}
{{define "copied"}}<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"/></svg>{{end}}
{{define "mark"}}{{template "ui-badge" .Badge}}{{end}}
{{define "confirmation-body"}}<p class="confirmation-meaning">A decision left blank goes as nothing. Whoever asked will see no answer to it.</p>
<ul class="confirmation-decisions"></ul>{{end}}
{{define "confirmation-actions"}}<button class="go-back" data-interaction="sending" type="button">Go back and answer</button>
<button class="send-anyway" data-interaction="sending" type="button" autofocus>Send anyway</button>{{end}}
{{define "entry"}}<span class="answered" data-answered="{{if .Decided}}{{if .Answered}}yes{{else}}no{{end}}{{else}}none{{end}}" aria-hidden="true">{{template "check"}}</span>
<span class="entry-heading"><span class="entry-name">{{.Name}}</span>{{with .Severity}}{{template "mark" .}}{{end}}</span>
{{if .Location}}<span class="location">{{.Location}}</span>{{end}}{{end}}
{{define "decision-content"}}<div class="seen" data-part="body">
<div class="attribution">
<span class="answered" data-answered="{{if .Answered}}yes{{else}}no{{end}}" aria-hidden="true">{{template "check"}}</span>
<span class="name">{{.Name}}</span>
{{with .Severity}}{{template "mark" .}}{{end}}
{{with .Audience}}{{template "mark" .}}{{end}}
{{if .Location}}<span class="location">{{.Location}}</span>{{end}}
</div>
<h2 class="question">{{.Question}}</h2>
{{if .Meaning}}<p class="meaning">{{.Meaning}}</p>{{end}}

{{if or .Evidence .Drawing}}
<div class="evidences">
{{range .Evidence}}
{{if .Diff}}
<div class="evidence diff" data-layout="split" data-language="{{.Written}}">
<div class="evidence-heading diff-heading">
<span class="evidence-label">{{with .Caption}}<span class="evidence-caption">{{.}}</span> {{end}}{{if eq .Diff.From .Diff.To}}<span class="diff-file">{{.Diff.From}}</span>{{else}}<span class="diff-from">{{.Diff.From}}</span> → <span class="diff-to">{{.Diff.To}}</span>{{end}}</span>
<span class="evidence-aside"><span class="diff-added">+{{.Diff.Added}}</span>
<span class="diff-removed">−{{.Diff.Removed}}</span></span>
</div>
{{range .Diff.Hunks}}
<table class="hunk">
{{if .Heading}}<caption>{{.Heading}}</caption>{{end}}
<tbody>
{{range .Rows}}
<tr class="row">
<td class="number" data-side="left" data-kind="{{.Left.Kind}}">{{.Left.Numbered}}</td>
<td class="line" data-side="left" data-kind="{{.Left.Kind}}"><span class="marker">{{.Left.Marker}}</span><code>{{.Left.Text}}</code></td>
<td class="number" data-side="right" data-kind="{{.Right.Kind}}">{{.Right.Numbered}}</td>
<td class="line" data-side="right" data-kind="{{.Right.Kind}}"><span class="marker">{{.Right.Marker}}</span><code>{{.Right.Text}}</code></td>
</tr>
{{end}}
</tbody>
</table>
{{end}}
</div>
{{else}}
<div class="evidence code">
<div class="evidence-heading"><span class="evidence-label">{{with .Caption}}<span class="evidence-caption">{{.}}</span> {{end}}{{if .Language}}{{.Language}}{{else if not .Caption}}code{{end}}</span>{{with .Copy}}<button class="copy" data-interaction="viewing" type="button" aria-label="{{.Label}}" data-title="{{.Label}}" data-hint="{{.Hint}}" data-copied-title="{{.Copied}}" data-failed-title="{{.Failed}}"><span class="copy-icon">{{template "copy"}}</span><span class="copy-done">{{template "copied"}}</span></button><span class="copy-status" role="status"></span>{{end}}</div>
<pre><code class="language-{{.Language}}">{{.Code}}</code></pre>
</div>
{{end}}
{{end}}

{{with .Drawing}}
<div class="evidence illustrated">
<div class="evidence-heading"><button class="expand" data-interaction="viewing" type="button" aria-label="Expand illustration" aria-expanded="false" data-title="Expand illustration" data-hint="Lays the drawing over the whole window. Escape closes it.">{{template "expand"}}</button></div>
<div class="drawing-stage">
<div class="drawing-backdrop"></div>
<iframe class="drawing" sandbox="allow-scripts" src="{{.Source}}" title="{{.Title}}"></iframe>
<button class="drawing-close" data-interaction="viewing" type="button">Close</button>
</div>
</div>
{{end}}
</div>
{{end}}
</div>

<div class="answering" data-part="footer">
{{if .Options}}
<fieldset class="options">
<legend>{{if .Multiple}}Choose as many as apply{{else}}Choose one{{end}}</legend>
{{$decision := .}}
<div class="options-list">
{{range .Options}}
<label class="option"{{if .Recommended}} data-recommended="yes"{{end}}>
<input class="choice" data-interaction="answering" type="{{if $decision.Multiple}}checkbox{{else}}radio{{end}}" name="choice-{{$decision.ID}}" value="{{.Position}}" data-decision="{{$decision.ID}}"{{if .Recommended}} checked{{end}}{{if $.Over}} disabled{{end}}>
<span class="option-label">{{.Label}}</span>
{{if .Recommended}}<span class="option-mark">Recommended</span>{{end}}
{{if .Meaning}}<span class="option-meaning">{{.Meaning}}</span>{{end}}
</label>
{{end}}
{{if not .Multiple}}
<label class="none">
<input class="decline" data-interaction="answering" type="radio" name="choice-{{.ID}}" data-decision="{{.ID}}"{{if $.Over}} disabled{{end}}>
<span class="option-label">None of these</span>
<span class="option-meaning">Write your own answer below, or leave this to whoever asked.</span>
</label>
{{end}}
</div>
</fieldset>
{{end}}

<label class="words">
<span class="words-label">In your own words</span>
<textarea class="words-field" data-interaction="answering" name="words-{{.ID}}" data-decision="{{.ID}}" rows="2" placeholder="Answering here alone is a complete answer."{{if $.Over}} disabled{{end}}></textarea>
</label>
</div>{{end}}
{{define "composer-content"}}<label class="message">
<span class="message-label">Anything to say to whoever asked</span>
<textarea class="message-field" data-interaction="sending" name="message" rows="3"{{if .Over}} disabled{{end}}></textarea>
</label>

<footer class="bar">
<output class="receipt" data-interaction="sending" hidden aria-live="polite">
{{template "ui-status-dot" statusDot "notice-dot" "resolved"}}
<span class="notice-said">
<span class="receipt-heading">Sent. Here is what went:</span>
<ul class="receipt-decisions"></ul>
<span class="receipt-message"></span>
</span>
</output>
<div class="sends">
<button class="send" data-interaction="sending" type="submit" data-ends="no"{{if .Over}} disabled{{end}}>Send and wait<span class="send-more"> for a reply</span></button>
<button class="finish" data-interaction="sending" type="submit" data-ends="yes"{{if .Over}} disabled{{end}}>Send and finish</button>
</div>
<p class="sends-meaning">Sending waits for a reply on this page. Finishing sends and closes the exchange.</p>
<button class="amend" data-interaction="sending" type="button" hidden{{if .Over}} disabled{{end}}>Amend and send again</button>
<p class="state" role="status" aria-live="polite" data-tone="{{if .Over}}over{{else}}quiet{{end}}">{{if .Over}}The exchange is over. Nothing further will be sent from this page.{{end}}</p>
</footer>{{end}}
{{define "nothing-content"}}<p class="nothing-said">There is nothing on this page to answer, and nobody is waiting on it.</p>{{end}}
<div class="surface">
<header class="topbar">
<div class="topbar-inner">
<span class="brand"><img class="brand-mark" src="/assets/socrates-mark.svg" width="28" height="28" alt=""><span class="wordmark">socrates</span></span>
<span class="crumb"><span class="crumb-title">{{.Title}}</span></span>
<span class="status" data-status="{{if not .Decisions}}nothing{{else if .Over}}over{{else}}open{{end}}">{{template "ui-status-dot" statusDot "" ""}}<span class="status-said">{{if not .Decisions}}Nothing to answer{{else if .Over}}Exchange over{{else}}Open{{end}}</span></span>
</div>
</header>

{{if .Decisions}}<form class="exchange shell" data-interaction="sending">{{else}}<div class="shell">{{end}}
{{if .Index}}
<nav class="index" aria-label="What was seen">
<div class="progress">
{{if .Decisions}}{{template "ui-overline" overline "" "Decisions"}}{{else}}{{template "ui-overline" overline "" "What was seen"}}{{end}}
{{if .Decisions}}
<span class="progress-said"><span class="answered-count">{{.AnsweredCount}}</span> of {{len .Decisions}} answered</span>
{{template "ui-progress-bar" progressBar "progress-bar" (len .Decisions) .AnsweredCount}}
{{end}}
</div>
<div class="index-group">
{{if .Decisions}}{{if eq (len .Index) (len .Decisions)}}{{template "ui-overline" overlineCounted "" "Still open" (len .Index)}}{{else}}{{template "ui-overline" overlineCounted "" "What was seen" (len .Index)}}{{end}}{{end}}
<ol class="entries">
{{range .Index}}
<li class="entry">
{{if .Decided}}<a class="entry-link" href="#decision-{{.ID}}" data-decision="{{.ID}}">{{template "entry" .}}</a>{{else}}<span class="entry-link">{{template "entry" .}}</span>{{end}}
</li>
{{end}}
</ol>
</div>
{{if .Settled}}
<div class="index-group">
{{template "ui-overline" overlineCounted "" "Settled earlier" (len .Settled)}}
<a class="settled-link" href="#settled">
<span class="settled-check">{{template "check"}}</span>
<span class="settled-link-count">{{len .Settled}} settled earlier</span>
<span class="settled-link-names">{{range $at, $answer := .Settled}}{{if $at}}, {{end}}{{$answer.Name}}{{end}}</span>
</a>
</div>
{{end}}
</nav>
{{end}}

<main class="main">
<div class="main-inner">
<header class="heading">
<span class="meta">{{if .Decisions}}{{len .Decisions}} open{{if .Settled}} · {{len .Settled}} settled earlier{{end}}{{else}}Nothing to answer{{end}}</span>
<h1>{{.Title}}</h1>
{{if .Preamble}}<p class="preamble">{{.Preamble}}</p>{{end}}
<p class="over-notice" role="status"{{if not (and .Over .Decisions)}} hidden{{end}}>{{template "ui-status-dot" statusDot "notice-dot" "neutral"}}<span class="over-notice-said">The exchange is over. Nothing further will be sent from this page.</span></p>
</header>

{{if .Settled}}
<details class="settled" id="settled"{{if not .Decisions}} open{{end}}>
<summary class="settled-summary">
<span class="settled-heading">
<span class="settled-title">Settled earlier <span class="settled-count">· {{len .Settled}}</span></span>
<span class="settled-note">Read-only. These will not be asked again.</span>
</span>
<span class="settled-toggle" aria-hidden="true"><span class="when-open">Hide</span><span class="when-closed">Show</span></span>
</summary>
<ol class="settled-answers">
{{range .Settled}}
<li class="settled-answer" data-settled="{{.ID}}">
<span class="settled-check">{{template "check"}}</span>
<div class="settled-attribution">
<span class="settled-name">{{.Name}}</span>
{{if .Location}}<span class="location">{{.Location}}</span>{{end}}
</div>
<p class="settled-question">{{.Question}}</p>
<div class="settled-answered">
{{template "ui-overline" overline "settled-overline" "Settled"}}
<span class="settled-said">
{{if .Chosen}}<span class="settled-chosen">{{.Chosen}}</span>{{end}}
{{if .Words}}<span class="settled-words">“{{.Words}}”</span>{{end}}
{{if and (not .Chosen) (not .Words)}}<span class="settled-left">Left to whoever asked</span>{{end}}
</span>
</div>
</li>
{{end}}
</ol>
</details>
{{if .Decisions}}{{template "ui-overline" overline "still-open" "Still open"}}{{end}}
{{end}}

{{if .Decisions}}
<ol class="decisions">
{{range .Decisions}}
<li class="decisions-item">{{template "ui-card" .Card}}</li>
{{end}}
</ol>

{{template "ui-card" .Composer}}
{{else}}
{{template "ui-card" .Nothing}}
{{end}}
</div>
</main>
{{if .Decisions}}
<aside class="panel" aria-label="Reply">
<div class="panel-body">
{{template "ui-overline" overline "" "Answer summary"}}
<ol class="summary"></ol>
</div>
</aside>
</form>

{{template "ui-dialog" .Confirmation}}
{{else}}
</div>
{{end}}
</div>
{{template "ui-tooltip" .Tooltip}}
<script src="/assets/surface.js"></script>
</body>
</html>
