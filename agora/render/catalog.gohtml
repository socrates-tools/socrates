<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta http-equiv="Content-Security-Policy" content="{{.Policy}}">
<title>{{.Title}}</title>
<link rel="icon" type="image/svg+xml" href="/assets/socrates-mark.svg">
<link rel="stylesheet" href="/assets/surface.css">
</head>
<body class="catalog">
{{define "catalog-dialog-body"}}<p>This dialog is drawn by the same partial the page draws a confirmation with.</p>{{end}}
{{define "catalog-dialog-actions"}}<button class="catalog-action" type="button" data-closes="catalog-dialog">Close</button>{{end}}
<main class="catalog-page">
<h1 class="catalog-title">{{.Title}}</h1>
{{range .Primitives}}<section class="catalog-primitive" data-primitive="{{.Name}}">
<h2 class="catalog-primitive-name">{{.Name}}</h2>
{{range .States}}<article class="catalog-state">
<h3 class="catalog-state-name">{{.Name}}</h3>
{{if .Opens}}<button class="catalog-opener" id="open-{{.Opens}}" type="button" data-opens="{{.Opens}}">Open</button>{{end}}
{{.Drawn}}
</article>
{{end}}</section>
{{end}}</main>
<script src="/assets/surface.js"></script>
</body>
</html>
