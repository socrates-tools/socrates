<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta http-equiv="Content-Security-Policy" content="{{.Policy}}">
<title>{{.Title}}</title>
<link rel="icon" type="image/svg+xml" href="/assets/socrates-mark.svg">
<link rel="stylesheet" href="/assets/surface.css">
</head>
<body class="catalog">
{{define "catalog-dialog-body"}}<p>This dialog is drawn by the same partial the page draws a confirmation with.</p>{{end}}
{{define "catalog-card-sections"}}<div data-part="body"><p>This card holds a body.</p></div><div data-part="footer"><p>And a footer under it.</p></div>{{end}}
{{define "catalog-card-body"}}<div data-part="body"><p>This card holds a body alone.</p></div>{{end}}
{{define "catalog-card-plain"}}<p class="catalog-card-plain">This card holds no sections, and sits as the page lays it out.</p>{{end}}
{{define "catalog-shell-topbar"}}<span class="catalog-shell-title">A shell</span>{{end}}
{{define "catalog-shell-navigation"}}<ol class="catalog-shell-links">{{range .Sections}}<li><a class="catalog-shell-link" href="#section-{{.}}" data-section="section-{{.}}">Section {{.}}</a></li>{{end}}</ol>{{end}}
{{define "catalog-shell-content"}}{{range .Sections}}<section class="catalog-shell-section" id="section-{{.}}"><h4>Section {{.}}</h4></section>{{end}}{{end}}
{{define "catalog-frame-document"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<link rel="stylesheet" href="/assets/surface.css">
</head>
<body>{{.}}<script src="/assets/surface.js"></script></body>
</html>{{end}}
{{define "catalog-shell-panel"}}<p class="catalog-shell-panel-said">The reply panel's place.</p>{{end}}
{{define "catalog-dialog-actions"}}<button class="catalog-action" type="button" data-closes="catalog-dialog">Close</button>{{end}}
<main class="catalog-page">
<h1 class="catalog-title">{{.Title}}</h1>
{{range .Primitives}}<section class="catalog-primitive" data-primitive="{{.Name}}">
<h2 class="catalog-primitive-name">{{.Name}}</h2>
{{range .States}}<article class="catalog-state" data-state="{{.Key}}">
<h3 class="catalog-state-name">{{.Name}}</h3>
{{if .Opens}}<button class="catalog-opener" id="open-{{.Opens}}" type="button" data-opens="{{.Opens}}">Open</button>{{end}}
{{with .Anchor}}<button class="catalog-anchor" id="{{.ID}}" type="button" data-tooltip="{{.Tooltip}}" data-title="{{.Title}}"{{with .Hint}} data-hint="{{.}}"{{end}}>{{.Label}}</button>{{end}}
{{with .Frame}}<iframe class="catalog-frame catalog-frame-{{.Width}}" width="{{.Width}}" height="{{.Height}}" title="{{.Title}}" srcdoc="{{.Document}}"></iframe>{{else}}{{.Drawn}}{{end}}
</article>
{{end}}</section>
{{end}}</main>
<script src="/assets/surface.js"></script>
</body>
</html>
