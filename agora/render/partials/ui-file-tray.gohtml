{{define "ui-file-tray"}}<ui-file-tray{{with .Class}} class="{{.}}"{{end}}{{with .Interaction}} data-interaction="{{.}}"{{end}}{{with .Sample}} data-sample="{{.}}"{{end}} max="{{.Max}}" remove-label="{{.RemoveLabel}}"><span slot="label">{{.Label}}</span><span slot="hint">{{.Hint}}</span><span slot="refusal">{{.Refusal}}</span></ui-file-tray>{{end}}
