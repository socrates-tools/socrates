{{define "ui-file-tray"}}<ui-file-tray{{with .Class}} class="{{.}}"{{end}}{{with .Interaction}} data-interaction="{{.}}"{{end}}{{with .Sample}} data-sample="{{.}}"{{end}} max="{{.Max}}"{{if .Disabled}} disabled{{end}} attach-label="{{.AttachLabel}}" remove-label="{{.RemoveLabel}}"><span slot="refusal">{{.Refusal}}</span>{{if .Content}}{{fillWith .Content .Data}}{{end}}</ui-file-tray>{{end}}
