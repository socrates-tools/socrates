{{define "ui-dialog"}}<ui-dialog class="{{.Class}}"{{with .Interaction}} data-interaction="{{.}}"{{end}}><dialog class="{{.Class}}"{{with .ID}} id="{{.}}"{{end}} data-part="panel" aria-labelledby="{{.Class}}-heading">
<h2 class="{{.Class}}-heading" id="{{.Class}}-heading" data-part="heading">{{.Heading}}</h2>
<div data-part="body">{{with .Body}}{{fill .}}{{end}}</div>
<div data-part="actions">{{with .Actions}}{{fill .}}{{end}}</div>
</dialog></ui-dialog>{{end}}
