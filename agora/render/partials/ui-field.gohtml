{{define "ui-field"}}<ui-field{{with .Class}} class="{{.}}"{{end}} name="{{.Name}}"{{with .Rows}} rows="{{.}}"{{end}}{{with .Placeholder}} placeholder="{{.}}"{{end}}{{with .Interaction}} data-interaction="{{.}}"{{end}}{{with .Decision}} data-decision="{{.}}"{{end}}{{if .Disabled}} disabled{{end}}{{if .Embedded}} embedded{{end}}><span slot="caption">{{.Caption}}</span></ui-field>{{end}}
