{{define "ui-field"}}<ui-field><label{{with .Class}} class="{{.}}"{{end}} data-part="frame"><span{{with .CaptionClass}} class="{{.}}"{{end}} data-part="caption">{{.Caption}}</span><textarea{{with .ControlClass}} class="{{.}}"{{end}} data-part="control" name="{{.Name}}"{{with .Rows}} rows="{{.}}"{{end}}{{with .Placeholder}} placeholder="{{.}}"{{end}}{{with .Interaction}} data-interaction="{{.}}"{{end}}{{with .Decision}} data-decision="{{.}}"{{end}}{{if .Disabled}} disabled{{end}}></textarea></label></ui-field>{{end}}
