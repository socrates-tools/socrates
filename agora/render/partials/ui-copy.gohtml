{{define "ui-copy"}}<ui-copy{{with .Text}} data-text="{{.}}"{{end}}><button class="copy" data-part="control" type="button"{{with .Interaction}} data-interaction="{{.}}"{{end}} aria-label="{{.Label}}" data-title="{{.Label}}" data-hint="{{.Hint}}" data-copied-title="{{.Copied}}" data-failed-title="{{.Failed}}"><span data-part="icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg></span><span data-part="done"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"/></svg></span></button><span class="copy-status" data-part="status" role="status"></span></ui-copy>{{end}}
