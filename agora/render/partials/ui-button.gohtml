{{define "ui-button"}}<ui-button data-variant="{{.Variant}}"{{if .Raised}} data-raised{{end}}><button{{with .Class}} class="{{.}}"{{end}} data-part="control" type="{{.Type}}"{{with .Interaction}} data-interaction="{{.}}"{{end}}{{with .Ends}} data-ends="{{.}}"{{end}}{{if .Hidden}} hidden{{end}}{{if .Disabled}} disabled{{end}}{{if .Autofocus}} autofocus{{end}}>{{if .Content}}{{fill .Content}}{{else}}{{.Label}}{{end}}</button></ui-button>{{end}}
