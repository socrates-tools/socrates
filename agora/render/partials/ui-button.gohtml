{{define "ui-button"}}<ui-button{{with .Class}} class="{{.}}"{{end}} variant="{{.Variant}}"{{if .Raised}} raised{{end}} type="{{.Type}}"{{with .Interaction}} data-interaction="{{.}}"{{end}}{{with .Ends}} data-ends="{{.}}"{{end}}{{if .Hidden}} hidden{{end}}{{if .Disabled}} disabled{{end}}{{if .Autofocus}} autofocus{{end}}>{{if .Content}}{{fill .Content}}{{else}}{{.Label}}{{end}}</ui-button>{{end}}
