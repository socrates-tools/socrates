{{define "ui-diff-block.number"}}<td class="w-10 align-top px-2 text-right select-none {{if eq .Cell.Kind "removed"}}bg-diff-removed-gutter text-fg-2{{else if eq .Cell.Kind "added"}}bg-diff-added-gutter text-fg-2{{else if eq .Cell.Kind "absent"}}bg-diff-absent text-fg-3{{else}}text-fg-3{{end}}" data-side="{{.Side}}" data-kind="{{.Cell.Kind}}">{{.Cell.Numbered}}</td>{{end}}
{{define "ui-diff-block.line"}}<td class="overflow-hidden align-top pr-3 whitespace-pre tab-4 text-fg-1 {{if eq .Side "left"}}border-r border-rule {{end}}{{if eq .Cell.Kind "removed"}}bg-diff-removed{{else if eq .Cell.Kind "added"}}bg-diff-added{{else if eq .Cell.Kind "absent"}}bg-diff-absent{{end}}" data-side="{{.Side}}" data-kind="{{.Cell.Kind}}"><span class="inline-block w-marker select-none {{if eq .Cell.Kind "removed"}}text-diff-removed-mark{{else if eq .Cell.Kind "added"}}text-diff-added-mark{{end}}">{{.Cell.Marker}}</span><code>{{.Cell.Text}}</code></td>{{end}}
{{define "ui-diff-block"}}<ui-diff-block language="{{.Language}}">{{range .Hunks}}<table class="block max-w-full overflow-x-auto border-collapse py-1.5 font-mono text-code leading-code">{{if .Heading}}<caption class="block px-3 py-0.5 text-left text-fg-3">{{.Heading}}</caption>{{end}}<tbody class="table w-full min-w-160 table-fixed border-collapse">{{range .Rows}}<tr>{{template "ui-diff-block.number" (dict "Side" "left" "Cell" .Left)}}{{template "ui-diff-block.line" (dict "Side" "left" "Cell" .Left)}}{{template "ui-diff-block.number" (dict "Side" "right" "Cell" .Right)}}{{template "ui-diff-block.line" (dict "Side" "right" "Cell" .Right)}}</tr>{{end}}</tbody></table>{{end}}</ui-diff-block>{{end}}
