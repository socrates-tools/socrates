{{define "ui-diff-block"}}<ui-diff-block data-language="{{.Language}}">{{range .Hunks}}<table class="hunk" data-part="hunk">{{if .Heading}}<caption data-part="heading">{{.Heading}}</caption>{{end}}<tbody>{{range .Rows}}<tr data-part="row"><td data-part="number" data-side="left" data-kind="{{.Left.Kind}}">{{.Left.Numbered}}</td><td class="line" data-part="line" data-side="left" data-kind="{{.Left.Kind}}"><span data-part="marker">{{.Left.Marker}}</span><code data-part="code">{{.Left.Text}}</code></td><td data-part="number" data-side="right" data-kind="{{.Right.Kind}}">{{.Right.Numbered}}</td><td class="line" data-part="line" data-side="right" data-kind="{{.Right.Kind}}"><span data-part="marker">{{.Right.Marker}}</span><code data-part="code">{{.Right.Text}}</code></td></tr>{{end}}</tbody></table>{{end}}</ui-diff-block>{{end}}
