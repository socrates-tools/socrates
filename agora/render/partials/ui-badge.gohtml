{{define "ui-badge"}}<ui-badge{{with .Class}} class="{{.}}"{{end}} tone="{{.Tone}}" icon="{{.Icon}}"{{range $name, $value := .Dataset}} data-{{$name}}="{{$value}}"{{end}}{{with .Title}} data-title="{{.}}"{{end}}{{with .Hint}} data-hint="{{.}}"{{end}}{{with .Spoken}} role="img" aria-label="{{.}}"{{end}}{{if .Focusable}} tabindex="0"{{end}}>{{with .Label}}<span slot="label">{{.}}</span>{{end}}</ui-badge>{{end}}
