{{define "ui-badge"}}<ui-badge{{with .Class}} class="{{.}}"{{end}} data-tone="{{.Tone}}"{{range $name, $value := .Dataset}} data-{{$name}}="{{$value}}"{{end}}{{with .Title}} data-title="{{.}}"{{end}}{{with .Hint}} data-hint="{{.}}"{{end}}{{with .Spoken}} role="img" aria-label="{{.}}"{{end}}{{if .Focusable}} tabindex="0"{{end}}><span data-part="icon">{{.Icon}}</span>{{with .Label}}<span data-part="label">{{.}}</span>{{end}}</ui-badge>{{end}}
